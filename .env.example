# Exemplo de configuração - Copie para .env e preencha com seus dados reais

# Configurações do Discord
DISCORD_TOKEN=SEU_TOKEN_DE_USUARIO_AQUI
SERVER_ID=1234567890123456789
CATEGORIA_ID=1234567890123456789

# Configurações de Email (para verificação de pagamentos)
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app_gmail
IMAP_SERVER=imap.gmail.com

# Mensagem de entrada nas threads
MENSAGEM_ENTRADA=👋 Olá! Use pg Nome Sobrenome para verificar seu pagamento.

# Configurações do Flask
FLASK_SECRET_KEY=sua_chave_secreta_muito_longa_e_aleatoria_aqui
DATABASE_URL=sqlite:///selfbot.db

# API SalasFF (para gerenciamento de salas)
SALASFF_API_KEY=sua_chave_da_api_salasff_aqui

# Configurações opcionais
PREFIXO_SALA=🎮 SALA FF:
IMAGEM_ENTRADA=https://exemplo.com/imagem.png